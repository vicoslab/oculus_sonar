<launch>

    <!-- Driver. Starts disabled: publish "true" on /oculus_sonar/enabled to start pinging,
         "false" to put the sonar in standby (safe out of water). Current state is latched
         on the same topic. -->
    <node name="oculus_sonar_node" pkg="oculus_sonar" type="oculus_sonar_node" output="screen">
        <param name="frequency_mode" value="2" /> <!-- High freq -->
        <param name="ping_rate" value="0" /> <!-- 10 hz-->
        <param name="data_depth" value="0" /> <!-- 8 bit-->
        <param name="nbeams" value="1" />  <!-- 512 beams -->
        <param name="send_gain" value="true" />
        <param name="gain_assist" value="false" />  <!-- doesn't work very well -->
        <param name="range" value="25.0" />  <!-- actual effective range in high freq-->
        <param name="gamma_correction" value="127" />
        <param name="gain_percent" value="60.0" />
        <param name="sound_speed" value="1537" />  <!-- 25 deg, 38 ppm salinity -->
        <param name="use_salinity" value="true" />
        <param name="salinity" value="38" /> <!-- adriatic -->
    </node>

    <!-- Image reprojector -->
    <node name="oculus_fan_reprojector" pkg="oculus_sonar" type="fan_reprojector.py" output="screen">
        <param name="downsample_factor" value="0.25" /> <!--quarter res-->
        <param name="use_compressed" value="false" /> <!--true for png compressed bag review-->
    </node>

</launch>
